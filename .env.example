NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
POSTGRES_DB=zamanushka
POSTGRES_USER=zamanushka
POSTGRES_PASSWORD=zamanushka_local
DATABASE_URL=postgresql://zamanushka:zamanushka_local@127.0.0.1:5432/zamanushka
TEST_DATABASE_URL=postgresql://zamanushka:zamanushka_local@127.0.0.1:5432/zamanushka_test
REDIS_URL=redis://127.0.0.1:6379

# Non-production mode is explicit: true enables dev-only auth; false enables Telegram auth.
DEV_AUTH_ENABLED=true
DEV_AUTH_USERS_JSON=[{"devUserKey":"player-1","displayName":"Player One"},{"devUserKey":"player-2","displayName":"Player Two"}]
APP_ORIGINS=http://127.0.0.1:5173

# Required in production and whenever DEV_AUTH_ENABLED=false. Replace locally; never commit a token.
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
SESSION_TTL_SECONDS=2592000
TELEGRAM_INIT_DATA_MAX_BYTES=16384
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
TELEGRAM_INIT_DATA_FUTURE_SKEW_SECONDS=30
