generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AuthMethod {
  TELEGRAM
  DEVELOPMENT
}

model User {
  id           String        @id @default(cuid())
  telegramId   BigInt?       @unique
  devUserKey   String?       @unique
  username     String?
  firstName    String
  lastName     String?
  languageCode String?
  photoUrl     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]
  roomSeats    RoomSeat[]
}

model AuthSession {
  id         String     @id @default(cuid())
  userId     String
  tokenHash  String     @unique
  authMethod AuthMethod
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedAt DateTime?
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Room {
  key           String     @id
  version       Int        @default(0)
  currentMatchId String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  seats         RoomSeat[]
  matches       Match[]
}

model Match {
  id             String            @id @default(cuid())
  roomKey        String
  firstPlayerId  String
  seatOrder      Json
  snapshot       Json
  stateVersion   Int               @default(0)
  lastSequence   Int               @default(0)
  status         String            @default("ACTIVE")
  terminalResult Json?
  finishedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  room           Room              @relation(fields: [roomKey], references: [key], onDelete: Cascade)
  events         MatchEvent[]
  actions        ProcessedAction[]
  outboxRows     OutboxRow[]

  @@index([roomKey])
}

model MatchEvent {
  id           String   @id @default(cuid())
  matchId      String
  sequence     Int
  stateVersion Int
  payload      Json
  createdAt    DateTime @default(now())
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, sequence])
  @@index([matchId, stateVersion])
}

model ProcessedAction {
  id                 String   @id @default(cuid())
  matchId            String
  actionId           String
  requestFingerprint String
  result             Json
  createdAt          DateTime @default(now())
  match              Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, actionId])
}

model OutboxRow {
  id                    String    @id @default(cuid())
  matchId               String
  resultingStateVersion Int
  payload               Json
  createdAt             DateTime  @default(now())
  publishedAt           DateTime?
  match                 Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, resultingStateVersion])
  @@index([publishedAt, createdAt])
}

model RoomSeat {
  roomKey  String
  seatIndex Int
  userId   String?  @unique
  ready    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room Room @relation(fields: [roomKey], references: [key], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@id([roomKey, seatIndex])
  @@index([roomKey])
}
