generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AuthMethod {
  TELEGRAM
  DEVELOPMENT
}

model User {
  id           String        @id @default(cuid())
  telegramId   BigInt?       @unique
  devUserKey   String?       @unique
  username     String?
  firstName    String
  lastName     String?
  languageCode String?
  photoUrl     String?
  rulesOnboardingSeenAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]
  roomSeats    RoomSeat[]
  roomMembership RoomMembership?
}

model AuthSession {
  id         String     @id @default(cuid())
  userId     String
  tokenHash  String     @unique
  authMethod AuthMethod
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedAt DateTime?
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Room {
  key           String     @id
  code          String     @unique
  status        String     @default("WAITING")
  version       Int        @default(0)
  currentMatchId String?    @unique
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  seats         RoomSeat[]
  memberships   RoomMembership[]
  matches       Match[]     @relation("RoomMatches")
  currentMatch  Match?      @relation("RoomCurrentMatch", fields: [currentMatchId], references: [id], onDelete: SetNull)
}

model RoomMembership {
  id        String   @id @default(cuid())
  roomKey   String
  userId    String   @unique
  joinedAt  DateTime @default(now())
  room      Room     @relation(fields: [roomKey], references: [key], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  seats     RoomSeat[]

  @@unique([roomKey, userId])
  @@index([roomKey])
}

model Match {
  id             String            @id @default(cuid())
  roomKey        String
  firstPlayerId  String
  seatOrder      Json
  snapshot       Json
  stateVersion   Int               @default(0)
  lastSequence   Int               @default(0)
  status         String            @default("ACTIVE")
  terminalResult Json?
  finishedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  room           Room              @relation("RoomMatches", fields: [roomKey], references: [key], onDelete: Restrict)
  currentForRoom Room?             @relation("RoomCurrentMatch")
  events         MatchEvent[]
  actions        ProcessedAction[]
  outboxRows     OutboxRow[]
  result         MatchResult?

  @@index([roomKey])
}

model MatchResult {
  id               String                   @id @default(cuid())
  matchId          String                   @unique
  roomKey          String
  winnerUserId     String
  victoryReason    String
  startedAt        DateTime
  finishedAt       DateTime
  participantCount Int
  createdAt        DateTime                 @default(now())
  match            Match                     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participants     MatchParticipantResult[]

  @@index([finishedAt])
  @@index([winnerUserId, finishedAt])
  @@index([roomKey, finishedAt])
}

model MatchParticipantResult {
  id            String      @id @default(cuid())
  matchResultId String
  userId        String
  displayName   String
  color         String
  outcome       String
  createdAt     DateTime    @default(now())
  matchResult   MatchResult @relation(fields: [matchResultId], references: [id], onDelete: Cascade)

  @@unique([matchResultId, userId])
  @@index([userId, matchResultId])
}

model MatchEvent {
  id           String   @id @default(cuid())
  matchId      String
  sequence     Int
  stateVersion Int
  payload      Json
  createdAt    DateTime @default(now())
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, sequence])
  @@index([matchId, stateVersion])
}

model ProcessedAction {
  id                 String   @id @default(cuid())
  matchId            String
  actionId           String
  requestFingerprint String
  result             Json
  createdAt          DateTime @default(now())
  match              Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, actionId])
}

model OutboxRow {
  id                    String    @id @default(cuid())
  matchId               String
  resultingStateVersion Int
  payload               Json
  createdAt             DateTime  @default(now())
  publishedAt           DateTime?
  leaseToken            String?
  leaseExpiresAt        DateTime?
  publishAttempts       Int       @default(0)
  match                 Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, resultingStateVersion])
  @@index([publishedAt, leaseExpiresAt, createdAt])
}

model RoomSeat {
  roomKey  String
  seatIndex Int
  userId   String?  @unique
  ready    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room Room @relation(fields: [roomKey], references: [key], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  membership RoomMembership? @relation(fields: [roomKey, userId], references: [roomKey, userId], onDelete: Restrict)

  @@id([roomKey, seatIndex])
  @@index([roomKey])
}
